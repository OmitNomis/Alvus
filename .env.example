# ─────────────────────────────────────────────
# Alvus Configuration
# ─────────────────────────────────────────────

# Your API keys, comma-separated (REQUIRED)
# Get free NVIDIA NIM keys at: https://build.nvidia.com
API_KEYS=nvapi-xxxxxxxxxxxx,nvapi-yyyyyyyyyyyy,nvapi-zzzzzzzzzzzz

# Port for the proxy to listen on
PORT=3000

# Upstream API base URL
# Default: NVIDIA NIM (LLMs and chat models)
TARGET_BASE_URL=https://integrate.api.nvidia.com/v1

# Upstream base URL for image/genai requests (/genai/ paths)
# Default: NVIDIA NIM visual models host
GENAI_BASE_URL=https://ai.api.nvidia.com

# How many seconds to cool a key after a 429 response
# 60s works well for most free-tier providers
COOLDOWN_SEC=60

# Requests per key per minute. Set this to your provider's published limit and
# Alvus paces each key to stay under it, instead of finding the limit by
# hitting it. NVIDIA NIM's free tier is around 40.
# 0 (the default) disables pacing — keys are only rested after a 429.
RPM_LIMIT=0

# Largest request body Alvus will accept, in MB. Bodies are held in memory so a
# retry can replay them against the next key, so this is a real memory ceiling.
# Raise it if you push large multimodal payloads through.
MAX_BODY_MB=32

# Token guarding the admin routes (/dashboard, /logs, /clear, /api/config).
# Only consulted when Alvus is bound to a non-loopback address (--network-only);
# a loopback bind leaves the admin surface open. If you run with --network-only
# and leave this blank, Alvus generates a token at startup and logs it once.
ADMIN_TOKEN=

# Force a specific upstream model regardless of what the client requests.
# Useful for the Claude Code mode (/v1/messages), where the client sends a
# claude-* model name the upstream won't recognize. Leave blank to pass through.
OVERRIDE_MODEL=